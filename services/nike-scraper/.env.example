# Porta da API
PORT=3001

# Margem aplicada sobre o preço convertido (em %). Ex.: 35 = +35%
MARGIN_PERCENT=35

# Tempo de vida do cache de buscas de produtos (minutos)
PRODUCT_CACHE_TTL_MIN=60

# Tempo de vida do cache da cotação USD-BRL (minutos)
RATE_CACHE_TTL_MIN=60

# Origens permitidas no CORS (separadas por vírgula). * libera tudo (só em dev)
CORS_ORIGINS=*

# Endpoints da Nike (não-oficiais — ajuste se a Nike mudar)
NIKE_SEARCH_URL=https://api.nike.com/discover/product_wall/v1/marketplace/US/language/en/consumerChannelId/d9a5bc42-4b9c-4976-858a-f159cf99c647
# UUID do Canal Nike (Usado na URL de busca e feed de produto)
NIKE_CHANNEL_ID="d9a5bc42-4b9c-4976-858a-f159cf99c647"

# Caller ID padrão para passar no header
NIKE_CALLER_ID="nike:dotcom:browse:wall.client:2.0"

# ---- câmbio: resiliência (opcional) ----
# ordem das fontes: AwesomeAPI → Frankfurter (BCE) → open.er-api; depois último câmbio conhecido (stale)
RATE_STALE_MAX_HOURS=72        # até quando servir o último câmbio conhecido se todas as fontes falharem
RATE_FAIL_BACKOFF_SEC=90       # não insistir numa fonte que acabou de falhar (429 etc.)
# RATE_FALLBACK_USD_BRL=5.40   # último recurso, só se configurado (marca source "fallback-env")
RATE_TOURISM_SPREAD_BRL=0.25   # dólar turismo (USD-BRLT); se a AwesomeAPI não trouxer, comercial + este valor
