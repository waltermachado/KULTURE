// Kulture core — Postgres (Railway em produção).
// Fase 0: cache persistente. Fase 2: auth (User + RefreshToken).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Cache genérico chave→JSON usado pelo SWR do catálogo (sobrevive a restart).
model CacheEntry {
  key       String   @id
  value     String
  savedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cache_entries")
}

// ─── Auth (Fase 2) ───────────────────────────────────────────────────────────

enum Role {
  customer
  admin
}

model User {
  id             String               @id @default(cuid())
  email          String               @unique
  passwordHash   String               @map("password_hash")
  name           String
  cpf            String?
  phone          String?
  /// endereço padrão do cliente (snapshot: cep, street, number, complement, neighborhood, city, state)
  address        Json?
  role           Role                 @default(customer)
  lastLoginAt    DateTime?            @map("last_login_at")
  /// quer receber novidades/promoções por e-mail (campanhas do backoffice); o link de descadastro desliga
  marketingOptIn Boolean              @default(true) @map("marketing_opt_in")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  refreshTokens  RefreshToken[]
  orders         Order[]
  passwordResets PasswordResetToken[]
  loginEvents    LoginEvent[]

  @@map("users")
}

/// Log de acessos: cada tentativa de login/cadastro/reset (sucesso ou falha), com IP e navegador.
/// Base para "últimos acessos" no backoffice e para investigar tentativas suspeitas.
model LoginEvent {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  kind      String   @default("login") // login | register | reset | logout
  ok        Boolean
  reason    String? // invalid_password | unknown_email | …
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@map("login_events")
}

/// Token de redefinição de senha (guardado como sha256; uso único; expira em 1h).
/// `requestedBy` = self (esqueci a senha) | admin (backoffice gerou o link).
model PasswordResetToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique @map("token_hash")
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedBy String    @default("self") @map("requested_by")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Refresh tokens com rotação: cada uso gera um novo token e revoga o anterior.
/// `family` agrupa tokens da mesma sessão para revogar tudo se detectar reutilização.
model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  family    String
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  revoked   Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

// ─── Pedidos & Checkout (Fase 4) ─────────────────────────────────────────────

enum OrderStatus {
  pending_payment
  paid
  abandoned
  cancelled
  refunded
  sourcing
  shipped
  delivered
}

model Order {
  id                  String      @id @default(cuid())
  number              String      @unique // Ex: KLT-2026-000123
  status              OrderStatus @default(pending_payment)
  userId              String?     @map("user_id")
  customerName        String      @map("customer_name")
  customerEmail       String      @map("customer_email")
  customerPhone       String      @map("customer_phone")
  customerCpf         String      @map("customer_cpf")
  address             Json // { cep, street, number, complement, neighborhood, city, state }
  subtotalBrl         Decimal     @map("subtotal_brl")
  shippingBrl         Decimal     @default(0) @map("shipping_brl")
  totalBrl            Decimal     @map("total_brl")
  exchangeRate        Decimal     @map("exchange_rate")
  pricingSnapshot     Json        @map("pricing_snapshot") // breakdown interno sumário
  paymentProvider     String      @map("payment_provider") // infinitepay | mock | manual (venda registrada no painel)
  /// Canal da venda: site (checkout) | whatsapp | instagram | presencial | outro — ≠ site = "venda externa"
  /// registrada pelo backoffice (POST /api/admin/orders), já paga, sem link de pagamento.
  channel             String      @default("site")
  paymentMethod       String?     @map("payment_method") // pix | credit_card
  infinitepaySlug     String?     @map("infinitepay_slug")
  transactionNsu      String?     @map("transaction_nsu")
  receiptUrl          String?     @map("receipt_url")
  paidAmountBrl       Decimal?    @map("paid_amount_brl")
  installments        Int?
  paidAt              DateTime?   @map("paid_at")
  abandonedAt         DateTime?   @map("abandoned_at")
  notifiedPendingAt   DateTime?   @map("notified_pending_at")
  notifiedPaidAt      DateTime?   @map("notified_paid_at")
  notifiedAbandonedAt DateTime?   @map("notified_abandoned_at")
  // ─── operação / entrega (backoffice) ───
  carrier             String? // Correios, Jadlog, DHL…
  trackingCode        String?     @map("tracking_code")
  trackingUrl         String?     @map("tracking_url")
  shippedAt           DateTime?   @map("shipped_at")
  deliveredAt         DateTime?   @map("delivered_at")
  cancelledAt         DateTime?   @map("cancelled_at")
  refundedAt          DateTime?   @map("refunded_at")
  internalNotes       String?     @map("internal_notes") // só backoffice, nunca sai na API pública
  // pronta entrega: itens de estoque próprio são reservados na criação do pedido; quando o pedido é
  // cancelado/abandonado a reserva volta ao estoque e este campo marca quando (evita devolver 2×)
  stockReleasedAt     DateTime?   @map("stock_released_at")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  items  OrderItem[]
  events OrderEvent[]

  user User? @relation(fields: [userId], references: [id])

  @@index([status, createdAt])
  @@index([transactionNsu])
  @@index([channel])
  @@map("orders")
}

model OrderItem {
  id               String   @id @default(cuid())
  orderId          String   @map("order_id")
  styleColor       String   @map("style_color")
  name             String
  colorDescription String?  @map("color_description")
  image            String?
  nikeSize         String   @map("nike_size")
  brSize           Decimal? @map("br_size")
  brLabel          String?  @map("br_label")
  sizeLabel        String?  @map("size_label") // "BR 38 (US M 7)" — como o cliente viu/escolheu (masc./fem./infantil)
  customization    Json? // Nike By You: { textLeft, numberLeft, textRight, numberRight } (texto até 8 chars, nº 2 dígitos)
  unitPriceBrl     Decimal  @map("unit_price_brl")
  unitPriceUsd     Decimal  @map("unit_price_usd")
  quantity         Int
  breakdown        Json // Breakdown interno do item

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id")
  type      String // created, link_created, payment_confirmed, webhook_received, abandoned, notified_*, error
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_events")
}

enum NotificationStatus {
  pending
  sent
  failed
}

model Notification {
  id               String             @id @default(cuid())
  orderId          String?            @map("order_id")
  channel          String             @default("whatsapp")
  to               String
  event            String
  text             String
  provider         String // log | evolution
  status           NotificationStatus @default(pending)
  providerResponse Json?              @map("provider_response")
  attempts         Int                @default(0)
  lastError        String?            @map("last_error")
  sentAt           DateTime?          @map("sent_at")
  createdAt        DateTime           @default(now()) @map("created_at")

  @@map("notifications")
}

model IdempotencyKey {
  key       String   @id
  response  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("idempotency_keys")
}

// ─── Pronta entrega (estoque próprio, no Brasil) ─────────────────────────────
// Produtos cadastrados no backoffice, sem consulta à Nike. `code` (PE-XXXXXX) é o "styleColor" usado
// no carrinho/pedido — o catálogo intercepta esse prefixo e responde do banco (ver catalog/service.js).

model StockProduct {
  id               String   @id @default(cuid())
  code             String   @unique // PE-XXXXXX (pronta entrega) | HY-XXXXXX (hypados)
  slug             String   @unique
  /// Seção da loja onde o produto aparece: stock (/pronta-entrega) | hypados (/hypados).
  /// Mesmo fluxo nos dois casos (estoque próprio, reserva por tamanho, fotos no banco).
  section          String   @default("stock")
  name             String
  subtitle         String? // texto livre (legado); o site usa o rótulo da categoria quando vazio
  category         String? // basketball | lifestyle | running — mesmas 3 abas da loja (Basquete / Casual / Corrida)
  gender           String   @default("M") // modelagem: M masculino | W feminino | U unissex (US da caixa em M; W = +1,5) | K infantil (GS)
  brand            String   @default("Nike")
  colorDescription String?  @map("color_description")
  styleColor       String?  @map("style_color") // SKU Nike real (só informativo)
  description      String?
  priceBrl         Decimal  @map("price_brl") // preço no Pix (final, frete embutido)
  fullPriceBrl     Decimal? @map("full_price_brl") // "de" riscado (opcional)
  costBrl          Decimal? @map("cost_brl") // custo do par (só backoffice: margem no dashboard)
  badge            String? // selo livre no card (ex.: "ÚLTIMO PAR")
  active           Boolean  @default(true)
  sortOrder        Int      @default(0) @map("sort_order")
  images           Json     @default("[]") // URLs ordenadas: /media/estoque/<StockImage.id> ou externas
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  sizes StockSize[]
  blobs StockImage[]

  @@index([active, sortOrder])
  @@index([section])
  @@map("stock_products")
}

model StockSize {
  id        String  @id @default(cuid())
  productId String  @map("product_id")
  br        String // numeração BR ("41", "41.5")
  us        String? // numeração US da caixa (opcional)
  qty       Int     @default(0)
  sortOrder Int     @default(0) @map("sort_order")

  product StockProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, br])
  @@map("stock_sizes")
}

/// Configuração editável do site (chave → JSON). Hoje: "featured" — tênis do hero por seção × categoria
/// (chaves "import|stock|hypados:default|basketball|lifestyle|running" → { type: "nike"|"stock", ref }).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

/// Foto enviada pelo backoffice (guardada no banco: não depende do volume ser gravável).
model StockImage {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  mime      String
  bytes     Int
  data      Bytes
  createdAt DateTime @default(now()) @map("created_at")

  product StockProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("stock_images")
}

/// E-mails que pediram para NÃO receber campanhas (link de descadastro / caixa em /conta). Vale também para quem
/// comprou como convidado (não tem users.marketing_opt_in). Nunca se apaga: quem voltar a querer marca na conta.
model MarketingUnsubscribe {
  email     String   @id
  reason    String   @default("link") // link | account | admin
  createdAt DateTime @default(now()) @map("created_at")

  @@map("marketing_unsubscribes")
}

/// Campanha de e-mail enviada pelo backoffice (/admin/marketing). O envio roda em segundo plano; total/sent/failed
/// contam o progresso. Sem log por destinatário (v1): o que importa é o resumo e o último erro.
model MarketingCampaign {
  id         String    @id @default(cuid())
  subject    String
  body       String
  ctaLabel   String?   @map("cta_label")
  ctaUrl     String?   @map("cta_url")
  imageUrl   String?   @map("image_url")
  audience   String    @default("all") // all | buyers | accounts
  status     String    @default("draft") // draft | sending | sent | failed
  total      Int       @default(0)
  sent       Int       @default(0)
  failed     Int       @default(0)
  lastError  String?   @map("last_error")
  createdBy  String?   @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")

  @@index([createdAt])
  @@map("marketing_campaigns")
}
