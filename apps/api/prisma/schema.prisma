// Kulture core — Postgres no Supabase.
// Fase 0: cache persistente. Fase 2: auth (User + RefreshToken).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Cache genérico chave→JSON usado pelo SWR do catálogo (sobrevive a restart).
model CacheEntry {
  key       String   @id
  value     String
  savedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cache_entries")
}

// ─── Auth (Fase 2) ───────────────────────────────────────────────────────────

enum Role {
  customer
  admin
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String         @map("password_hash")
  name          String
  cpf           String?
  role          Role           @default(customer)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  refreshTokens RefreshToken[]

  @@map("users")
}

/// Refresh tokens com rotação: cada uso gera um novo token e revoga o anterior.
/// `family` agrupa tokens da mesma sessão para revogar tudo se detectar reutilização.
model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  family    String
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  revoked   Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}
