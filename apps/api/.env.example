# ---- servidor ----
PORT=3000
HOST=127.0.0.1
# true em produção atrás de proxy (Railway): rate limit usa o IP real do cliente
TRUST_PROXY=false
LOG_LEVEL=info
NODE_ENV=development

# ---- banco (Postgres — em produção o Postgres do Railway; em dev pode ser o mesmo via URL pública ou um Postgres local) ----
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/railway"
# usado pelo `prisma migrate`; se vazio, o entrypoint usa DATABASE_URL (Railway não tem pooler separado)
DIRECT_URL=

# ---- scraper Nike (services/nike-scraper) ----
SCRAPER_URL=http://localhost:3001

# ---- CORS (só necessário se o front NÃO usar o proxy do Vite) ----
CORS_ORIGINS=http://localhost:5173

# ---- catálogo ----
# base pública das imagens espelhadas (em produção, seu CDN)
MEDIA_BASE=/media/produtos
# cache de dados: fresco por 1h, stale servível por 24h se o scraper cair
CACHE_FRESH_MIN=60
CACHE_STALE_MIN=1440
# destaques da home (termos de busca separados por vírgula)
TOP8_TERMS=Kobe 10 Protro,Kobe IX Elite Low EM Protro,Kobe III Protro,Sabrina 3,LeBron XXIII,Book 2,Air Jordan 1 Low OG,G.T. Cut 3
# pré-aquecer o top8 na subida e a cada hora
TOP8_WARM=true

# ---- auth (Fase 2) ----
JWT_SECRET="troque-por-uma-string-longa-e-aleatoria-32-chars"
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_DAYS=7
# ---- backoffice (/admin) ----
# e-mails (separados por vírgula) que viram admin automaticamente ao logar/cadastrar.
# alternativa: npm run admin:make -w apps/api -- email@dominio.com
ADMIN_EMAILS=
# validade do link "esqueci minha senha" (minutos)
PASSWORD_RESET_TTL_MIN=60

# ---- e-mail transacional (MailerSend via API HTTP) ----
# log = só registra (dev). mailersend = envia de verdade (produção).
MAIL_PROVIDER=log
MAILERSEND_API_TOKEN=
# remetente: o domínio precisa estar VERIFICADO na conta MailerSend (SPF/DKIM)
MAIL_FROM=no-reply@seu-dominio.com.br
MAIL_FROM_NAME=Kulture

# ---- produto de teste de pagamento ----
# "test123test" (R$ 1,00) só aparece buscando exatamente esse nome. Desligue após validar o pagamento real.
TEST_PRODUCT_ENABLED=true

# ---- precificação ----
# Preço Pix = ↑99( [(USD × 1,07 + 65) × dólar TURISMO] × 1,30 ). Regras em packages/shared/src/pricing/default-rules.js.
MAX_INSTALLMENTS=12            # frase "em até 12x no cartão" (parcelas/juros reais são configurados na conta InfinitePay)
RATE_TOURISM_SPREAD_BRL=0.25   # se o dólar turismo (AwesomeAPI USD-BRLT) faltar: comercial + este valor

# ---- atendimento (WhatsApp mostrado no site) ----
# "Não achou o tênis? Chama no WhatsApp": DDI+DDD+número, só dígitos. Vazio = o site usa o número do rodapé.
# (Não confundir com WHATSAPP_PROVIDER/WHATSAPP_TO, que são as notificações de pedido.)
WHATSAPP_CONTACT_PHONE=5585992578888

# ---- pronta entrega (estoque próprio) ----
# Sem variável: cadastro em /admin/estoque (nome, descrição, preço, fotos, tamanhos/qtd). Fotos ficam no banco
# (tabela stock_images) e são servidas em /media/estoque/:id — não dependem do volume ser gravável.
