# ---- servidor ----
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
NODE_ENV=development

# ---- banco (Postgres no Supabase) ----
# Pooler (porta 6543, transaction mode) — usado pelo app em runtime
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direto (porta 5432) — usado pelo Prisma Migrate
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres"

# ---- scraper Nike (services/nike-scraper) ----
SCRAPER_URL=http://localhost:3001

# ---- CORS (só necessário se o front NÃO usar o proxy do Vite) ----
CORS_ORIGINS=http://localhost:5173

# ---- catálogo ----
# base pública das imagens espelhadas (em produção, seu CDN)
MEDIA_BASE=/media/produtos
# cache de dados: fresco por 1h, stale servível por 24h se o scraper cair
CACHE_FRESH_MIN=60
CACHE_STALE_MIN=1440
# destaques da home (termos de busca separados por vírgula)
TOP8_TERMS=Kobe 10 Protro,Kobe IX Elite Low EM Protro,Kobe III Protro,Sabrina 3,LeBron XXIII,Book 2,Air Jordan 1 Low OG,G.T. Cut 3
# pré-aquecer o top8 na subida e a cada hora
TOP8_WARM=true
